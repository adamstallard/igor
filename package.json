{
  "name": "igor-lore",
  "version": "0.1.0",
  "license": "ISC",
  "description": "The lore store: curated team knowledge as markdown in git",
  "type": "module",
  "bin": {
    "igor": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "templates",
    "docs",
    "deploy",
    "igor.config.example.yaml"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/cli.js",
    "prepack": "rm -rf dist && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lore": "tsx src/cli.ts",
    "igor": "tsx src/cli.ts"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "picomatch": "^4.0.2",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/picomatch": "^3.0.1",
    "tsx": "^4.19.1",
    "typescript": "^6.0.3",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=26"
  }
}
