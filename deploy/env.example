# Copy to /etc/igor/env (systemd) or .env (compose). Contains credentials: chmod 600.

# Acts on the tracker and the code host. A fine-grained token for the machine account of
# this Igor, scoped to the repositories it works, with Issues, Pull requests and Contents
# read/write. Not admin, not a classic token. See docs/machine-accounts.md.
GH_TOKEN=

# One per seat, named by `token_env` in igor.config.yaml. From `claude setup-token` run
# while signed in as that seat. A seat naming a variable that is unset is skipped, never
# substituted with whatever login is ambient.
IGOR_SEAT_1=
