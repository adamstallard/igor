# systemd unit for one Igor. Install per role:
#
#   sudo cp deploy/igor.service /etc/systemd/system/igor@.service
#   sudo systemctl enable --now igor@maintenance
#
# The template takes the role name as its instance, so several Igors run side by side from
# one unit file and one installation.

[Unit]
Description=Igor (%i)
Documentation=https://github.com/adamstallard/igor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=igor
WorkingDirectory=/srv/igor/lore

# Absolute paths, because a service inherits no shell. A version manager that puts node
# under a per-shell directory will break here the first time it cleans that directory up;
# point at a stable interpreter instead.
ExecStart=/usr/local/bin/igor serve %i

# Igor runs git, gh and claude by name, so they must be on this PATH, and systemd's default
# does not include the directory claude's native installer uses: ~/.local/bin of whoever ran
# it. Replace /home/igor with the service user's home, or with wherever
# `sudo -u igor sh -lc 'command -v claude'` says claude is. (%h will not do here: in a system
# unit it is root's home, whatever User= says.) Without this, every model call fails to start.
Environment=PATH=/home/igor/.local/bin:/usr/local/bin:/usr/bin:/bin

# A native install updates itself in the background, so a release that changes how claude -p
# authenticates can arrive overnight (igor#144). Upgrade deliberately instead: `claude update`
# as the service user, then restart.
Environment=DISABLE_AUTOUPDATER=1

# Two files, because the two kinds of credential have different scopes. Seat tokens are
# shared: a seat is a Claude subscription several Igors may draw from. The surface token is
# not, because one machine account per Igor is what makes a claim say who has your issue —
# a shared GH_TOKEN gives every instance the same identity. The per-instance file is optional
# so a single-Igor install needs only the first.
# Keep both 0600 and owned by the service user; they hold credentials that act on your
# repositories.
EnvironmentFile=/etc/igor/env
EnvironmentFile=-/etc/igor/%i.env

# A seat token specifically may skip the line above instead: encrypt it once with
# `systemd-creds encrypt`, name it here, and point that seat's `token_file` in
# igor.config.yaml at the literal path systemd decrypts it to — `systemd.exec(5)` documents
# where $CREDENTIALS_DIRECTORY resolves for a unit like this one. Nothing then sits in this
# unit's own environment. See docs/deployment.md.
#LoadCredential=igor-seat-example:/etc/igor/igor-seat-example.cred

Restart=always
RestartSec=30

# How long shutdown waits, not a promise the item in hand finishes: a worker is bounded by
# silence on its stream and may run for hours. An Igor killed mid-item leaves a claim with no
# explanation, which is the one failure the claim protocol exists to prevent — raise this where
# a long item matters more than a prompt shutdown. See docs/deployment.md.
KillSignal=SIGTERM
TimeoutStopSec=900

StandardOutput=journal
StandardError=journal
SyslogIdentifier=igor-%i

# Nothing here needs privilege beyond its own working tree and a temp directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/igor

[Install]
WantedBy=multi-user.target
