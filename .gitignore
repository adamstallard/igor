# Defense in depth only. The real boundary is that private data is written
# OUTSIDE this tree — see docs/architecture.md. Never rely on this file to
# keep something out of history: publishing a repo exposes all history, so a
# leak committed and later deleted is still exposed at publication.

# Lore stores and anything derived from a real repository's review history.
# These belong in the operating team's repo, never in Igor's — the destination
# guard enforces that, and these patterns are the belt-and-braces half.
lore/
entries/
*.ledger

# Real config — repo names, reviewer handles, expert designations, and
# possibly inline keys. Commit the .example.* variants instead, with
# placeholders, so the shape is documented without the contents.
igor.config.*
!igor.config.example.*
*.config.local.*
config.local.*
.igorrc
.igor/

# Scratch, spikes, and run output
scratch/
out/
tmp/
*.local.*

# Credentials
.env
.env.*
*.pem
*.key
credentials.json

# Node
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*

# Git worktrees for parallel work. Inside the repo so tooling finds the checkout,
# never part of it.
.claude/worktrees/
